{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/merci.html",
      "destination": "/merci/",
      "permanent": true
    },
    {
      "source": "/cv/sylvain-brochu-cv.pdf",
      "destination": "/api/cv/?v=carriere",
      "permanent": false
    }
  ],
  "functions": {
    "api/courriels.js": {
      "maxDuration": 60,
      "includeFiles": "api/_fichiers/**"
    },
    "api/cv.js": {
      "includeFiles": "api/_fichiers/**"
    },
    "api/offres.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(styles.css|main.js|favicon.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}